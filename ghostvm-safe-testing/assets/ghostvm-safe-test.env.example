# Example environment configuration for ghostvm-safe-testing scripts.
# Copy to: .env.ghostvm (or similar) and source it.

# VM name (bundle expected at ~/VMs/<Name>.GhostVM)
GHOSTVM_VM_NAME="dev"

# Snapshot to revert before each run
GHOSTVM_SNAPSHOT="clean-state"

# Host input directory to mount read-only
GHOSTVM_HOST_RO="/Users/me/src/my-repo"

# Host output directory to mount read-write (dedicated artifacts dir)
GHOSTVM_HOST_RW="/Users/me/.ghostvm-artifacts"

# Default command to run inside the VM
GHOSTVM_CMD="swift test"

# Command timeout (seconds)
GHOSTVM_CMD_TIMEOUT=3600
